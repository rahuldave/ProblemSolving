flowchart LR
  n0(["Write 3/4 as a decimal."])
  n1(["Answer: 0.75"])
  n2{{"× Which first step?"}}
  n3["Divide the top by the bottom<br/>3 ÷ 4 = 0.75<br/>[divide · within]"]
  n4["Scale the bottom up to 10, 100, or 1000<br/>4 × 25 = 100<br/>[multiply · within]"]
  n5["Scale the top by the same factor<br/>3 × 25 = 75"]
  n6["Read off the decimal<br/>75 ÷ 100 = 0.75"]
  n0 --> n2
  n2 -->|"Divide"| n3
  n3 --> n1
  n2 -->|"Scale to 10, 100, 1000"| n4
  n5 --> n6
  n6 --> n1
  n4 --> n5

flowchart LR
  n0(["Solve 3/5 = x/40."])
  n1(["Answer: 24"])
  n2{{"× Which first step?"}}
  n3["Find the scale factor between the bottoms<br/>40 ÷ 5 = 8<br/>[divide · across]"]
  n4["Scale the top by the same factor<br/>3 × 8 = 24"]
  n5["Divide the top by the bottom<br/>3 ÷ 5 = 0.6<br/>[divide · within]<br/>[in: Write a fraction as a decimal]"]
  n6["Scale up to 40<br/>0.6 × 40 = 24"]
  n7["Divide the top by the bottom<br/>5 ÷ 3 ≈ 1.667<br/>[divide · within]<br/>[in: Write a fraction as a decimal]"]
  n8["Divide by that rate<br/>40 ÷ 5/3 = 24"]
  n9["Find the greatest common factor<br/>GCF(3, 5) = 1<br/>[factor · within]<br/>[in: Simplify a fraction]"]
  n10{"all"}
  n11{"all"}
  n12["Divide the top by the GCF<br/>3 ÷ 1 = 3<br/>[in: Simplify a fraction]"]
  n13["Divide the bottom by the GCF<br/>5 ÷ 1 = 5<br/>[in: Simplify a fraction]"]
  n14["Find the scale factor from the simplified bottom<br/>40 ÷ 5 = 8"]
  n15["Scale the simplified top<br/>3 × 8 = 24"]
  n16["Multiply across the diagonal<br/>3 × 40 = 120<br/>[multiply · across]"]
  n17["Divide by the remaining number<br/>120 ÷ 5 = 24"]
  n18["Scale the bottom up to 10, 100, or 1000<br/>5 × 2 = 10<br/>[multiply · within]<br/>[in: Write a fraction as a decimal]"]
  n19["Scale the top by the same factor<br/>3 × 2 = 6<br/>[in: Write a fraction as a decimal]"]
  n20["Read off the decimal<br/>6 ÷ 10 = 0.6<br/>[in: Write a fraction as a decimal]"]
  n21["Scale up to 40<br/>0.6 × 40 = 24"]
  n22["Build the bottom up by 2, 3, 4, … until it reaches 40<br/>5 × 8 = 40<br/>[multiply · within]"]
  n23["Scale the top by the same factor<br/>3 × 8 = 24"]

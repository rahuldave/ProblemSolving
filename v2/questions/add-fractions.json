{
  "id": "add-fractions",
  "kind": "core",
  "title": "Add two fractions",
  "prompt": "Find {a}/{b} + {c}/{d}.",
  "inputs": { "a": "numerator 1", "b": "denominator 1", "c": "numerator 2", "d": "denominator 2" },
  "quantities": { "fraction1": ["a", "b"], "fraction2": ["c", "d"] },
  "outputs": ["answer"],
  "default_method": "common_denominator",
  "examples": [
    { "id": "5/6 + 3/4", "values": { "a": 5, "b": 6, "c": 3, "d": 4 }, "answer": "19/12" },
    { "id": "2/3 + 1/5", "values": { "a": 2, "b": 3, "c": 1, "d": 5 }, "answer": "13/15" }
  ],
  "methods": {
    "common_denominator": {
      "name": "Common denominator",
      "idea": "Rewrite both fractions over a common denominator, add the numerators, simplify.",
      "best_when": "Always; use the least common multiple to keep numbers small.",
      "steps": [
        { "op": "use", "question": "common-multiple", "with": { "x": "b", "y": "d" }, "out": { "answer": "L" }, "say": "Find a common denominator" },
        { "op": "all", "say": "Rewrite both fractions over it", "branches": [
          [ { "op": "use", "question": "missing-value", "with": { "a": "a", "b": "b", "d": "L" }, "out": { "answer": "n1" }, "say": "Rewrite the first fraction over {L}" } ],
          [ { "op": "use", "question": "missing-value", "with": { "a": "c", "b": "d", "d": "L" }, "out": { "answer": "n2" }, "say": "Rewrite the second fraction over {L}" } ]
        ] },
        { "op": "add", "args": ["n1", "n2"], "out": "s", "say": "Add the new tops" },
        { "op": "use", "question": "simplify-fraction", "with": { "x": "s", "y": "L" }, "out": { "x1": "sn", "y1": "sd" }, "say": "Simplify the sum" },
        { "op": "divide", "args": ["sn", "sd"], "out": "answer", "hidden": true }
      ]
    },
    "bow_tie": {
      "name": "Bow-tie (cross-multiply)",
      "idea": "({a}×{d} + {c}×{b}) / ({b}×{d}), then simplify.",
      "best_when": "Quick, with small denominators.",
      "watch_out": "When the denominators share a factor, the result needs simplifying.",
      "steps": [
        { "op": "all", "say": "Find the cross products and the product of the bottoms", "branches": [
          [ { "op": "use", "question": "cross-products", "with": { "a": "a", "b": "b", "c": "c", "d": "d" }, "out": { "p1": "p1", "p2": "p2" }, "say": "Find the cross products" } ],
          [ { "op": "multiply", "args": ["b", "d"], "out": "P", "say": "Multiply the bottoms" } ]
        ] },
        { "op": "add", "args": ["p1", "p2"], "out": "s", "say": "Add the cross products for the new top" },
        { "op": "use", "question": "simplify-fraction", "with": { "x": "s", "y": "P" }, "out": { "x1": "sn", "y1": "sd" }, "say": "Simplify the sum" },
        { "op": "divide", "args": ["sn", "sd"], "out": "answer", "hidden": true }
      ]
    },
    "decimal": {
      "name": "Convert to decimals",
      "idea": "Write each fraction as a decimal and add.",
      "best_when": "An approximate answer is enough.",
      "watch_out": "Repeating decimals (5/6 = 0.8333…) make the written sum inexact.",
      "steps": [
        { "op": "all", "say": "Write both as decimals", "branches": [
          [ { "op": "use", "question": "to-decimal", "with": { "x": "a", "y": "b" }, "out": { "answer": "q1" }, "say": "Write the first fraction as a decimal" } ],
          [ { "op": "use", "question": "to-decimal", "with": { "x": "c", "y": "d" }, "out": { "answer": "q2" }, "say": "Write the second fraction as a decimal" } ]
        ] },
        { "op": "add", "args": ["q1", "q2"], "out": "answer", "say": "Add the decimals" }
      ]
    }
  }
}

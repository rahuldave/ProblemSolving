{
  "id": "free-throws",
  "title": "Free throws",
  "text": "Maya made 3 of her 4 free throws. Leo made 5 of his 7. Who has the better shooting rate?",
  "concepts": [
    "question_type",
    "rate_pair",
    "direction"
  ],
  "quantities": [
    {
      "id": "maya_made",
      "text": "made 3",
      "value": 3,
      "unit": "shots",
      "counts": "Maya's made shots"
    },
    {
      "id": "maya_shots",
      "text": "of her 4",
      "value": 4,
      "unit": "shots",
      "counts": "Maya's attempts"
    },
    {
      "id": "leo_made",
      "text": "made 5",
      "value": 5,
      "unit": "shots",
      "counts": "Leo's made shots"
    },
    {
      "id": "leo_shots",
      "text": "of his 7",
      "value": 7,
      "unit": "shots",
      "counts": "Leo's attempts"
    }
  ],
  "asks": {
    "text": "who has the better shooting rate",
    "unit": "name"
  },
  "extract": [
    {
      "op": "choose",
      "concept": "question_type",
      "say": "What kind of question is this?",
      "options": [
        {
          "say": "Whose rate is higher: compare two fractions",
          "correct": true,
          "question": "compare-fractions",
          "binds": {
            "a": "maya_made",
            "b": "maya_shots",
            "c": "leo_made",
            "d": "leo_shots"
          },
          "answer_map": {
            "first": "Maya",
            "second": "Leo",
            "equal": "they're tied"
          }
        }
      ]
    },
    {
      "op": "choose",
      "concept": "rate_pair",
      "say": "What is each player's rate?",
      "options": [
        {
          "say": "Shots made out of shots taken",
          "correct": true
        },
        {
          "say": "Just the shots made",
          "trap": "Compares shots made only (5 > 3).",
          "binds": {
            "b": 1,
            "d": 1
          }
        }
      ]
    },
    {
      "op": "choose",
      "concept": "direction",
      "say": "Which way wins?",
      "options": [
        {
          "say": "The bigger fraction made",
          "correct": true
        },
        {
          "say": "The bigger fraction missed",
          "trap": "Compares misses per shot and picks the bigger.",
          "steps": [
            {
              "op": "subtract",
              "args": [
                "maya_shots",
                "maya_made"
              ],
              "out": "maya_missed",
              "say": "Count Maya's misses"
            },
            {
              "op": "subtract",
              "args": [
                "leo_shots",
                "leo_made"
              ],
              "out": "leo_missed",
              "say": "Count Leo's misses"
            }
          ],
          "binds": {
            "a": "maya_missed",
            "c": "leo_missed"
          }
        }
      ]
    }
  ],
  "answer": "Maya",
  "answer_text": "Maya (3/4 = 0.75 vs 5/7 ≈ 0.714)"
}

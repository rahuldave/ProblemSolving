flowchart LR
  n0(["Write 5/8 as a decimal."])
  n1(["Answer: 0.625"])
  n2{{"× Which first step?"}}
  n3["Divide the top by the bottom<br/>5 ÷ 8 = 0.625<br/>[divide · within]"]
  n4["Scale the bottom up to 10, 100, or 1000<br/>8 × 125 = 1000<br/>[multiply · within]"]
  n5["Scale the top by the same factor<br/>5 × 125 = 625"]
  n6["Read off the decimal<br/>625 ÷ 1000 = 0.625"]
  n0 --> n2
  n2 -->|"Divide"| n3
  n3 --> n1
  n2 -->|"Scale to 10, 100, 1000"| n4
  n5 --> n6
  n6 --> n1
  n4 --> n5
  classDef k_choice fill:#fff1cc,stroke:#c99a1a,color:#222
  classDef k_end fill:#d4f0da,stroke:#2f8a45,color:#222,font-weight:bold
  classDef k_first fill:#e3edfd,stroke:#5b7fd1,color:#222
  classDef k_start fill:#fde4e1,stroke:#c4554a,color:#222
  classDef k_step fill:#ffffff,stroke:#7a8599,color:#222

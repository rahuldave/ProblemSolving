flowchart LR
  n0(["Solve 4/6 = x/15."])
  n1(["Answer: 10"])
  n2{{"× Which first step?"}}
  n3["Find the scale factor between the bottoms<br/>15 ÷ 6 = 2.5<br/>[divide · across]"]
  n4["Scale the top by the same factor<br/>4 × 2.5 = 10"]
  n5["Divide the top by the bottom<br/>4 ÷ 6 ≈ 0.667<br/>[divide · within]<br/>[in: Write a fraction as a decimal]"]
  n6["Scale up to 15<br/>2/3 × 15 = 10"]
  n7["Divide the top by the bottom<br/>6 ÷ 4 = 1.5<br/>[divide · within]<br/>[in: Write a fraction as a decimal]"]
  n8["Divide by that rate<br/>15 ÷ 1.5 = 10"]
  n9["Divide the top by a shared factor<br/>4 ÷ 2 = 2<br/>[factor · within]<br/>[in: Simplify a fraction]"]
  n10["Divide the bottom by the same factor<br/>6 ÷ 2 = 3<br/>[in: Simplify a fraction]"]
  n11["Find the scale factor from the simplified bottom<br/>15 ÷ 3 = 5"]
  n12["Scale the simplified top<br/>2 × 5 = 10"]
  n13["Find the greatest common factor<br/>GCF(4, 6) = 2<br/>[factor · within]<br/>[in: Simplify a fraction]"]
  n14{"all"}
  n15{"all"}
  n16["Divide the top by the GCF<br/>4 ÷ 2 = 2<br/>[in: Simplify a fraction]"]
  n17["Divide the bottom by the GCF<br/>6 ÷ 2 = 3<br/>[in: Simplify a fraction]"]
  n18["Find the scale factor from the simplified bottom<br/>15 ÷ 3 = 5"]
  n19["Scale the simplified top<br/>2 × 5 = 10"]
  n20["Multiply across the diagonal<br/>4 × 15 = 60<br/>[multiply · across]"]
  n21["Divide by the remaining number<br/>60 ÷ 6 = 10"]
  n22["Scale the bottom up to 10, 100, or 1000<br/>4 × 25 = 100<br/>[multiply · within]<br/>[in: Write a fraction as a decimal]"]
  n23["Scale the top by the same factor<br/>6 × 25 = 150<br/>[in: Write a fraction as a decimal]"]
  n24["Read off the decimal<br/>150 ÷ 100 = 1.5<br/>[in: Write a fraction as a decimal]"]
  n25["Divide by that rate<br/>15 ÷ 1.5 = 10"]
